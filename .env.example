# Hear-Me-Out local dev configuration
# Copy this file to .env and fill in your server details

SERVER_IP=<your-server-ip>
API_PORT=5001
PERSONAPLEX_PORT=8000
MEANVC_PORT=5002

# Frontend voice-analysis mode after a VC conversation:
# off      = never show/run post-VC voice analysis
# manual   = show analysis buttons, do not auto-run them (default)
# after_vc = legacy auto-run of voice-change metrics after VC
VITE_VOICE_ANALYSIS_MODE=manual
